# Staging template: same shape as production, separate domain, database and secrets, FAKE data only.
# Copy to the staging server as .env. Never reuse production passwords or APP_KEY here.
APP_NAME="TaskFlow Staging"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.staging.taskflow.com
FRONTEND_URL=https://app.staging.taskflow.com
BCRYPT_ROUNDS=12
TRUSTED_PROXIES=127.0.0.1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow_staging
DB_USERNAME=taskflow_app
DB_PASSWORD=<different long random password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=taskflow_staging_session
SESSION_DOMAIN=.staging.taskflow.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.staging.taskflow.com

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Staging must never email real users: log or a sandbox inbox only.
MAIL_MAILER=log
