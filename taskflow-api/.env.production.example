# Production template (guide 13.4). Copy to the SERVER as .env and fill in the <...> values.
# NEVER commit the filled-in file. Generate APP_KEY on the server: php artisan key:generate
APP_NAME=TaskFlow
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://api.taskflow.com
FRONTEND_URL=https://app.taskflow.com
APP_LOCALE=en
BCRYPT_ROUNDS=12

# Nginx runs on the same host. Use '*' only if PHP-FPM is not reachable except through the proxy.
TRUSTED_PROXIES=127.0.0.1

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taskflow
DB_USERNAME=taskflow_app
DB_PASSWORD=<long random password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_COOKIE=taskflow_session
SESSION_DOMAIN=.taskflow.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=app.taskflow.com

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Password-reset emails (use a real SMTP provider)
MAIL_MAILER=smtp
MAIL_HOST=<smtp host>
MAIL_PORT=587
MAIL_USERNAME=<smtp user>
MAIL_PASSWORD=<smtp password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@taskflow.com
MAIL_FROM_NAME="${APP_NAME}"
